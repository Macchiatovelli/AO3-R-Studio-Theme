/* rs-theme-name: AO3 */
/* rs-theme-is-dark: FALSE */

/* ==========================================================================
   AO3 (Archive of Our Own) inspired theme for RStudio  -  v3

   Theme chrome (backgrounds, borders, tabs, selection):
     AO3 red ........ #990000
     Parchment ...... #f4ecea  (panes / toolbars)
     Rose tints ..... #eadbd8, #d8c9c6 (strips, borders)
     Chunk fill ..... #f0e0dd
     Ink ............ #2a2a2a

   Syntax TEXT colors come from AO3's symbol key (text only, never fills).
   Three categories each own a color that nothing else uses:
     KEYWORDS ............ Explicit red   #a40d0d  (bold)
     FUNCTION ARGUMENTS .. F/M plum       #8a2a6e
     BUILT-IN CONSTANTS .. Teen gold      #b8860b  (bold italic)
   Everything else shares the remaining key colors:
     F/F crimson #c0141c   M/M blue #1f5fb0   External blue #1b6aa5
     General green #5f8c00 Gen green #3f8a2a  Mature orange #d9701a
   ========================================================================== */


/* --------------------------------------------------------------------------
   FONT
   The editor and console font is NOT set by this theme. Choose it yourself
   in Tools > Global Options > Appearance > Editor font.
   -------------------------------------------------------------------------- */

/* Interface text uses AO3's own stack (not a character grid, so proportional is fine) */
.rstudio-themes-flat .gwt-TabLayoutPanelTab,
.rstudio-themes-flat .rstheme_toolbarWrapper,
.rstudio-themes-flat .rstheme_secondaryToolbar,
.rstudio-themes-flat .rstheme_minimizedWindow,
.rstudio-themes-flat .gwt-MenuItem,
.rstudio-themes-flat .gwt-Anchor,
.rstudio-themes-flat .gwt-Label,
.rstudio-themes-flat .gwt-Button {
  font-family: "Lucida Sans Unicode", "Lucida Grande", "Lucida Sans", Verdana, sans-serif !important;
}


/* --------------------------------------------------------------------------
   RSTUDIO INTERFACE: replaces the default blue with AO3 parchment and red.
   Selectors follow the structure RStudio's own themes (e.g. rsthemes) use.
   -------------------------------------------------------------------------- */

/* Frames and backgrounds */
.rstudio-themes-flat .rstudio-themes-background,
.rstudio-themes-flat .windowframe {
  background-color: #f4ecea !important;
  border-color: #d8c9c6 !important;
}
.rstudio-themes-flat .rstudio-themes-border {
  border-color: #d8c9c6 !important;
}

/* Toolbars (global toolbar, document toolbar, pane toolbars, grid headers) */
.rstudio-themes-flat .rstheme_toolbarWrapper,
.rstudio-themes-flat .rstheme_secondaryToolbar,
.rstudio-themes-flat .rstheme_sidebarWrapper,
.rstudio-themes-flat .rstheme_dominantToolbar,
.rstudio-themes-flat .rstheme_center,
.rstudio-themes-flat .dataGridHeader,
.rstudio-themes-flat tr[__gwt_header_row] > td,
.rstudio-themes-flat tr[__gwt_header_row] > th {
  background: #f4ecea !important;
  border-color: #d8c9c6 !important;
}

/* Pane toolbars and wrappers that have no class of their own */
.rstudio-themes-flat .windowframe > div:last-child > div > div > div > div > div:not(.gwt-TabLayoutPanelTabs) {
  background: #f4ecea !important;
}
.rstudio-themes-flat .windowframe > div:last-child > div > div > div:nth-child(3) > div {
  background: #f4ecea !important;
}

/* Catch-all for pane contents (Files list, Environment grid, History).
   RStudio's blue sits on class names that change between versions, so rather
   than naming them, every div inside a pane becomes transparent and the
   parchment frame shows through. This is deliberately NOT !important, so the
   specific rules above and below (toolbars, tabs, progress bars) still win. */
.rstudio-themes-flat .windowframe div {
  background-color: transparent;
}
.rstudio-themes-flat .windowframe td,
.rstudio-themes-flat .windowframe th {
  border-color: #d8c9c6;
}

/* Tab strips and inactive tabs (document tabs and pane tabs) */
table.rstheme_tabLayoutCenter,
.rstudio-themes-flat .gwt-TabLayoutPanelTabs,
.rstheme_multiPodUtilityTabArea {
  background: #eadbd8 !important;
}
.rstudio-themes-flat .gwt-TabLayoutPanelTabs {
  border-bottom: 2px solid #990000 !important;
}
table.rstheme_tabLayoutCenter .gwt-Label,
.rstudio-themes-flat .gwt-TabLayoutPanelTabs .gwt-Label,
.rstheme_multiPodUtilityTabArea .gwt-Label {
  color: #6b1a1a !important;
}
.rstudio-themes-flat .gwt-TabLayoutPanelTab:hover table.rstheme_tabLayoutCenter {
  background: #e0cbc7 !important;
}

/* Selected tab: white with a red cap, like AO3's active nav item */
.rstudio-themes-flat .gwt-TabLayoutPanelTabs .gwt-TabLayoutPanelTab-selected table.rstheme_tabLayoutCenter,
.rstudio-themes-flat .gwt-TabLayoutPanelTab-selected .rstheme_center {
  background: #ffffff !important;
}
.rstudio-themes-flat .gwt-TabLayoutPanelTab-selected table.rstheme_tabLayoutCenter {
  border-top: 3px solid #990000 !important;
}
.rstudio-themes-flat .gwt-TabLayoutPanelTab-selected .gwt-Label {
  color: #990000 !important;
  font-weight: bold;
}

/* Minimized pane bars: AO3 header red */
.rstudio-themes-flat .rstheme_minimizedWindow {
  background-color: #990000 !important;
  color: #ffffff !important;
  border-color: #6e0000 !important;
}

/* Splitters */
.rstudio-themes-flat .gwt-SplitLayoutPanel-HDragger,
.rstudio-themes-flat .gwt-SplitLayoutPanel-VDragger {
  background-color: #d8c9c6 !important;
}

/* Links */
.rstudio-themes-flat a,
.rstudio-themes-flat .gwt-Anchor,
.rstudio-themes-flat .gwt-Hyperlink a {
  color: #990000 !important;
}
.rstudio-themes-flat a:hover,
.rstudio-themes-flat .gwt-Anchor:hover {
  color: #555555 !important;
}

/* Progress bars */
.rstheme_toolbarWrapper [role="progressbar"] > div,
.windowframe [role="progressbar"] > div {
  background-color: #990000 !important;
}


/* --------------------------------------------------------------------------
   EDITOR CHROME
   -------------------------------------------------------------------------- */
.ace_editor {
  background-color: #ffffff !important;
  color: #2a2a2a !important;
}

.ace_gutter {
  background: #eeeeee;
  color: #888888;
  border-right: 1px solid #dddddd;
}
.ace_gutter-active-line {
  background-color: #e6d3d1;
  color: #990000;
}

.ace_print-margin {
  width: 1px;
  background: #e4d6d4;
}

.ace_cursor {
  color: #990000 !important;
  border-color: #990000 !important;
}

.ace_marker-layer .ace_selection { background: #f0cfcb; }
.ace_multiselect .ace_selection.ace_start { box-shadow: 0 0 3px 0px #ffffff; }
.ace_marker-layer .ace_selected-word {
  background: #f7e4e1;
  border: 1px solid #d9a5a0;
}
.ace_marker-layer .ace_active-line { background: #fcf4f3; }
.ace_marker-layer .ace_bracket {
  margin: -1px 0 0 -1px;
  border: 1px solid #999999;
}
.ace_marker-layer .ace_stack { background: #ecd9d6; }
.ace_marker-layer .ace_step { background: #ecd9d6; }

.ace_indent-guide {
  background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAACCAYAAACZgbYnAAAAE0lEQVQImWP4////f4bLly//BwAmVgd1/w11/gAAAABJRU5ErkJggg==") right repeat-y;
}
.ace_invisible { color: #d5c5c3; }
.ace_fold {
  background-color: #990000;
  border-color: #2a2a2a;
}

/* Layer stacking: required so marker backgrounds (chunks) sit behind the text */
.ace_layer { z-index: 4; }
.ace_layer.ace_print-margin-layer { z-index: 2; }
.ace_layer.ace_marker-layer { z-index: 1; }
.ace_layer.ace_cursor-layer { z-index: 3; }


/* --------------------------------------------------------------------------
   R MARKDOWN / QUARTO CHUNK BACKGROUND
   -------------------------------------------------------------------------- */
.ace_marker-layer .ace_foreign_line {
  position: absolute;
  z-index: -1;
  background-color: #f0e0dd !important;
}
.ace_marker-layer .ace_active_debug_line {
  position: absolute;
  z-index: -1;
  background-color: #ecd9d6;
}
.ace_marker-layer .ace_find_line {
  position: absolute;
  z-index: -1;
  background-color: #ecd9d6;
}


/* --------------------------------------------------------------------------
   SYNTAX SCOPES  (AO3 symbol-key text colors)
   -------------------------------------------------------------------------- */

/* KEYWORDS: Explicit red, bold. Used by nothing else. */
.ace_keyword,
.ace_storage,
.ace_storage.ace_type {
  color: #a40d0d;
  font-weight: bold;
}

/* Operators: muted; assignment and pipes in F/F crimson */
.ace_keyword.ace_operator {
  color: #7a4a4a;
  font-weight: normal;
}
.ace_keyword.ace_operator.ace_assignment,
.ace_keyword.ace_operator.ace_infix {
  color: #c0141c;
}

/* FUNCTION ARGUMENTS: F/M plum. Used by nothing else. */
.ace_variable.ace_parameter {
  color: #8a2a6e;
}

/* BUILT-IN CONSTANTS (TRUE, FALSE, NULL, NA, Inf, pi...): Teen gold,
   bold italic. Used by nothing else. */
.ace_constant.ace_language,
.ace_support.ace_constant {
  color: #b8860b;
  font-style: italic;
  font-weight: bold;
}

/* Identifiers and other variables */
.ace_identifier { color: #2a2a2a; }
.ace_variable { color: #3a3a3a; }
.ace_variable.ace_language {
  color: #1b6aa5;
  font-style: italic;
}

/* Functions: M/M blue; built-ins and classes: External-work blue */
.ace_entity.ace_name.ace_function { color: #1f5fb0; }
.ace_support.ace_function { color: #1b6aa5; }
.ace_support.ace_class,
.ace_support.ace_type {
  color: #1b6aa5;
  font-weight: bold;
}

/* Strings: General Audiences green */
.ace_string { color: #5f8c00; }
.ace_string.ace_regexp {
  color: #3f8a2a;
  background: #f5f1f0;
}

/* Numbers: Mature orange */
.ace_constant.ace_numeric { color: #d9701a; }
.ace_constant.ace_character,
.ace_constant.ace_other { color: #d9701a; }
.ace_constant.ace_character.ace_escape { color: #c95a00; }

/* Comments: quiet grey; roxygen tags in Gen green */
.ace_comment {
  color: #888888;
  font-style: italic;
}
.ace_comment.ace_doc { color: #6b6b6b; }
.ace_comment.ace_doc.ace_tag {
  color: #3f8a2a;
  font-weight: bold;
}

/* Rainbow parentheses (avoids the three exclusive colors above) */
.ace_paren_color_0 { color: #c0141c; }
.ace_paren_color_1 { color: #1f5fb0; }
.ace_paren_color_2 { color: #3f8a2a; }
.ace_paren_color_3 { color: #d9701a; }
.ace_paren_color_4 { color: #1b6aa5; }
.ace_paren_color_5 { color: #555555; }
.ace_paren_color_6 { color: #c95a00; }

/* Errors: text color only */
.ace_invalid {
  color: #c0141c;
  text-decoration: underline wavy #c0141c;
  background: transparent;
}
.ace_invalid.ace_deprecated {
  color: #c95a00;
  text-decoration: line-through;
  background: transparent;
}


/* --------------------------------------------------------------------------
   MARKDOWN / R MARKDOWN / HTML inside documents
   -------------------------------------------------------------------------- */
.ace_markup.ace_heading {
  color: #c0141c;
  font-weight: bold;
}
.ace_markup.ace_list { color: #d9701a; }
.ace_markup.ace_underline { text-decoration: underline; }
.ace_markup.ace_strong { font-weight: bold; }
.ace_markup.ace_emphasis { font-style: italic; }
.ace_markup.ace_href,
.ace_string.ace_href {
  color: #1f5fb0;
  text-decoration: underline;
}
.ace_markup.ace_code,
.ace_markup.ace_raw { color: #1b6aa5; }
.ace_markup.ace_quote {
  color: #6b6b6b;
  font-style: italic;
}

/* Chunk fences: ```{r} and ``` */
.ace_support.ace_function.ace_codebegin,
.ace_support.ace_function.ace_codeend {
  color: #7a4a4a;
}

.ace_meta.ace_tag { color: #c0141c; }
.ace_meta.ace_tag.ace_tag-name {
  color: #c0141c;
  font-weight: bold;
}
.ace_entity.ace_other.ace_attribute-name { color: #c95a00; }
.ace_support.ace_type.ace_property-name { color: #1b6aa5; }


/* --------------------------------------------------------------------------
   CONSOLE
   -------------------------------------------------------------------------- */
.ace_console_error { color: #c0141c; }
.ace_console_output { color: #2a2a2a; }


/* --------------------------------------------------------------------------
   AUTOCOMPLETE POPUP
   -------------------------------------------------------------------------- */
.ace_editor.ace_autocomplete {
  border: 1px solid #990000;
  background: #ffffff;
  color: #2a2a2a;
}
.ace_editor.ace_autocomplete .ace_marker-layer .ace_active-line {
  background-color: #f0cfcb;
}
.ace_editor.ace_autocomplete .ace_completion-highlight {
  color: #990000;
}


/* --------------------------------------------------------------------------
   DATA VIEWER (View(df) tables): header, row numbers, footer, grid lines
   -------------------------------------------------------------------------- */
.dataTables_wrapper .dataTables_scrollHead,
.dataTables_wrapper .dataTables_scrollHeadInner,
.dataTables_wrapper thead th,
.dataTables_wrapper thead td,
table.dataTable thead th,
table.dataTable thead td {
  background-color: #eadbd8 !important;
  color: #6b1a1a !important;
  border-color: #d8c9c6 !important;
}

/* Row-number column */
.dataTables_scrollBody table tbody td:first-child,
table.dataTable tbody td:first-child {
  background-color: #f4ecea !important;
  color: #990000 !important;
  border-color: #d8c9c6 !important;
}

/* Body cells and grid lines */
.dataTables_wrapper table td,
.dataTables_wrapper table th,
table.dataTable td,
table.dataTable th {
  border-color: #d8c9c6 !important;
}
table.dataTable.cell-border tbody th,
table.dataTable.cell-border tbody td {
  border-color: #d8c9c6 !important;
}

/* Footer ("Showing 1 to 25 of ...") and pagination */
.dataTables_info,
.dataTables_wrapper .dataTables_info,
.dataTables_wrapper .dataTables_paginate,
.dataTables_wrapper .dataTables_length {
  background-color: #f4ecea !important;
  color: #6b1a1a !important;
  border-top: 2px solid #990000 !important;
}
